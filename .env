# CRAFTS - Supabase Environment Configuration
# To connect your own live Supabase backend:
# 1. Go to https://supabase.com and create or open your project
# 2. Go to Project Settings > API
# 3. Copy Project URL and Project API Key (anon public)
# 4. If left blank, the app will automatically and safely save all inquiries in local storage buffer

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
